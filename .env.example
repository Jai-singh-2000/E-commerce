# ---------------------------------------------------------------------------
# Backend configuration. Copy to .env and fill in real values.
# Never commit the populated .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/planet

# JWT signing key. Must be at least 32 characters in production.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# SMTP credentials. Mail delivery is skipped when these are absent.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Razorpay keys. Online payment endpoints are disabled when absent.
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
